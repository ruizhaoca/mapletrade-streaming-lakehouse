# Confluent Kafka
CONFLUENT_BOOTSTRAP_SERVERS=pkc-xxxxx.region.provider.confluent.cloud:9092
CONFLUENT_KAFKA_API_KEY=replace_me
CONFLUENT_KAFKA_API_SECRET=replace_me
KAFKA_TOPIC=mapletrade.trade-events.v1

# Confluent Schema Registry
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.region.provider.confluent.cloud
SCHEMA_REGISTRY_API_KEY=replace_me
SCHEMA_REGISTRY_API_SECRET=replace_me

# Databricks secret scope and keys used by the notebooks
DATABRICKS_SECRET_SCOPE=mapletrade
DATABRICKS_KAFKA_KEY_SECRET=kafka-api-key
DATABRICKS_KAFKA_SECRET_SECRET=kafka-api-secret
DATABRICKS_SCHEMA_REGISTRY_KEY_SECRET=schema-registry-api-key
DATABRICKS_SCHEMA_REGISTRY_SECRET_SECRET=schema-registry-api-secret

