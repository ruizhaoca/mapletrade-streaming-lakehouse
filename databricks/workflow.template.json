{
  "name": "mapletrade-mvp",
  "max_concurrent_runs": 1,
  "timeout_seconds": 7200,
  "tasks": [
    {
      "task_key": "ingest_and_transform",
      "existing_cluster_id": "<YOUR_CLUSTER_ID>",
      "notebook_task": {
        "notebook_path": "<REPO_WORKSPACE_PATH>/databricks/02_ingest_and_transform",
        "base_parameters": {
          "catalog": "mapletrade_dev",
          "source_mode": "kafka",
          "pipeline_run_id": "{{job.run_id}}",
          "secret_scope": "mapletrade",
          "bootstrap_servers": "<CONFLUENT_BOOTSTRAP_SERVERS>",
          "kafka_topic": "mapletrade.trade-events.v1"
        },
        "source": "WORKSPACE"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 30000,
      "timeout_seconds": 3600
    },
    {
      "task_key": "build_gold_and_reconcile",
      "depends_on": [
        {
          "task_key": "ingest_and_transform"
        }
      ],
      "existing_cluster_id": "<YOUR_CLUSTER_ID>",
      "notebook_task": {
        "notebook_path": "<REPO_WORKSPACE_PATH>/databricks/03_build_gold_and_reconcile",
        "base_parameters": {
          "catalog": "mapletrade_dev",
          "pipeline_run_id": "{{job.run_id}}",
          "as_of_date": "2026-08-11"
        },
        "source": "WORKSPACE"
      },
      "max_retries": 1,
      "min_retry_interval_millis": 30000,
      "timeout_seconds": 3600
    }
  ]
}

